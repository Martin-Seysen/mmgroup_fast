/** @file mm_op_fast_g_init.c

 File ``mm_op_fast_g_init.c`` provides the basic functions for
 constructing structures of type ``mmv_fast_g_type``
 representing elements of the Monster.

 This is not yet functional!
*/


#include <stdint.h>
#include <stdatomic.h>
#include <stddef.h>
#include <stdlib.h>


/// @cond DO_NOT_DOCUMENT 
#define MM_OP_FAST_ALLOC
/// @endcond 

#include "mm_reduce.h"
#include "mm_op_fast.h"
#include "mm_op_sub.h"   


//  %%GEN h
/// @cond DO_NOT_DOCUMENT

//  %%GEN c



/// @cond DO_NOT_DOCUMENT


#define MM_FAST_MAXLEN_G 0x800
#define MM_FAST_MAXLEN_G_RED 65


ALIGNED(64) struct mm_fast_g_type {
    uint64_t int_g[4];
    ALIGNED(64) uint64_t atomic_buffer[16];
    mmv_fast_matrix_type *p_mat;
    uint32_t len_g;
    uint32_t g[MM_FAST_MAXLEN_G];
    uint32_t len_g_reduced;
    uint32_t g_reduced[MM_FAST_MAXLEN_G_RED];
    int64_t substatus;  // error status from lower level
    int64_t sub_op;     // operation where erro occured
};


#define FLAG_G        ((int64_t)0x1ULL)
#define FLAG_SHORT    ((int64_t)0x2ULL)
#define FLAG_MAT      ((int64_t)0x4ULL)
#define FLAG_REDUCED  ((int64_t)0x8ULL)
#define FLAG_ERROR    ((int64_t)0x10ULL)
#define FLAG_FROZEN   ((int64_t)0x20ULL)
#define FLAG_STABLE   ((int64_t)0x40ULL)

#define DATA_FLAGS ( \
 FLAG_G | FLAG_SHORT | FLAG_MAT | FLAG_REDUCED | FLAG_ERROR) 


#ifdef __cplusplus
    static_assert(sizeof(mm_fast_g_type) <= 0x40000, "Buffer for struct mm_fast_g_type too small");
#else
    _Static_assert(sizeof(mm_fast_g_type) <= 0x40000, "Buffer for struct mm_fast_g_type too small");
#endif

// Return a pointer to an _Atomic(int64_t)  pointing to space
// at p_gobj->atomic_buffer
#define get_atomic_p_flags(p_gobj) \
    (_Atomic(uint64_t) *)(void *)(p_gobj->atomic_buffer);

/// @endcond


/**********************************************************************
* Get flags for an object of type ``mm_fast_g_type``
**********************************************************************/

/// @cond DO_NOT_DOCUMENT

static uint64_t 
get_flags(mm_fast_g_type *p_gobj)
// Return flags of object *p_gobj of type mm_fast_g_typ
{
    if (p_gobj == NULL) return FLAG_ERROR & FLAG_FROZEN;
    _Atomic(uint64_t) *p_flags = get_atomic_p_flags(p_gobj);
    uint64_t flags = atomic_load_explicit(
        p_flags,
        memory_order_acquire);
    return flags;
}


static int32_t is_mutable(uint64_t flags)
// Return 1 if ``flags`` indicate that object is mutable, 0 otherwise. 
// ``flags`` should be as retruend by function ``get_flags``.
{
    return (flags & (FLAG_ERROR | FLAG_FROZEN)) == 0;
}



/**
   @brief Get flags of object of type ``mm_fast_g_type``

   The function returns the status of an object of
   type ``mm_fast_g_type``. This is a function for debugging.
   ``status`` in an array of 5 integers where the following
   components of ``p_gobj`` will be stored:

   flags,  sub_op, substatus, len_g, len_g_reduced .
*/
// %%EXPORT p
void fast_g_obj_get_status(mm_fast_g_type *p_gobj, int64_t *p_status)
{
     memset(p_status, 0, 5 * sizeof(uint32_t));
     if (p_gobj == NULL) return;
     p_status[0] = get_flags(p_gobj);
     p_status[1] = p_gobj->sub_op;
     p_status[2] = p_gobj->substatus;
     p_status[3] = p_gobj->len_g;
     p_status[4] = p_gobj->len_g_reduced;
}



static uint64_t 
get_write_access(mm_fast_g_type *p_gobj, uint64_t requested)
// Wait until object *p_gobj of type mm_fast_g_typ is writable and
// return flags of that object. If all flags of the object in
// parameter ``requested`` are set then we assume that there is no
// need to modify the object, and we return without waiting for
// write access. We also return without waiting if the object is
// not (yet) frozen.
{
    if (p_gobj == NULL) return FLAG_ERROR & FLAG_FROZEN;
    _Atomic(uint64_t) *p_flags =  get_atomic_p_flags(p_gobj);
    uint64_t flags = atomic_load_explicit(
        p_flags,
        memory_order_acquire);


    /* FAST PATH */
    if ((flags & requested) == requested)  return flags;

    /* PRE-FREEZE PATH (single-threaded contract) */
    if (!(flags & FLAG_FROZEN)) return flags;

    /* POST-FREEZE PATH (single initializer) */

    /* acquire ownership */
    uint64_t desired;

    do {
        /* already satisfied */
        if ((flags & requested) == requested)  return flags;

        /* attempt to become initializer */
        flags |= FLAG_STABLE;
        desired = flags &~ FLAG_STABLE; /* ownership mechanism unchanged in flags design */

    } while (!atomic_compare_exchange_weak_explicit(
                 p_flags,
                 &flags,
                 desired,
                 memory_order_acq_rel,
                 memory_order_acquire));

    return flags;
}


static uint64_t 
release_write_access(mm_fast_g_type *p_gobj, uint64_t old_flags, uint64_t new_flags)
{
    new_flags |= (old_flags & FLAG_ERROR) | FLAG_STABLE;
    _Atomic(uint64_t) *p_flags =  get_atomic_p_flags(p_gobj);
    atomic_store_explicit(
        p_flags,
        new_flags,
        memory_order_release);
    return new_flags;    
}


/**
   @brief Set an error in object of type ``mm_fast_g_type``

   Here ``op`` describes a function where the error occures
   and ``status`` describes an error at a low-level function.
   The function returns the flags after setting the error.
*/
static inline int64_t
set_error(mm_fast_g_type *p_gobj, int64_t op, int64_t status)
{
    if (p_gobj == NULL) return FLAG_ERROR | FLAG_FROZEN;
    _Atomic(uint64_t) *p_flags =  get_atomic_p_flags(p_gobj);
    uint64_t flags = atomic_fetch_or(
        p_flags, FLAG_ERROR | FLAG_FROZEN);
    if ((flags & FLAG_ERROR) == 0) {
        p_gobj->sub_op = op;
        p_gobj->substatus = status;        
    }
    return flags | FLAG_ERROR | FLAG_FROZEN;
}

/**
   @brief same as set_error(), but returns -1
*/
static inline int32_t
set_error_ret(mm_fast_g_type *p_gobj, int64_t op, int64_t status)
{
    set_error(p_gobj, op, status);
    return -1;
}

#define ERROR_MUTABLE -11

/// @endcond


/**********************************************************************
* Create and delete a buffer for an object of type ``mm_fast_g_type``
**********************************************************************/

/// @cond DO_NOT_DOCUMENT

static inline void set_int_g_neutral(mm_fast_g_type *p_gobj)
// Set p_gobj->int_g to the integer code of the neutral element
{
    p_gobj->int_g[0] = MAT24_ORDER;
    p_gobj->int_g[1] = p_gobj->int_g[2] = p_gobj->int_g[3] = 0;
}
/// @endcond



/**
   @brief Create new object of type ``mm_fast_g_type``

   The function creates a new object of type ``mmv_fast_matrix_type``
   and returns a pointer to the object or NULL in case of failure.
   The new object is mutable and has the neutral element as value.

   Internally, we create a vector of type ``mmv_fast_matrix_type``
   an we use the slack in the vector data for storing the group    
   element.
*/
// %%EXPORT p
mm_fast_g_type *fast_g_obj_new()
{
    mmv_fast_matrix_type *p_mat = mm_op_fast_alloc(3, 4, 1, 0);
    if (p_mat == 0) return NULL;
    uint32_t buf_size;
    // steal a buffer from the ``mmv_fast_matrix_type`` object
    mm_fast_g_type *p_gobj = mm_op_fast_get_slack(p_mat, &buf_size);
    if (buf_size < sizeof(mm_fast_g_type)) return NULL;
    p_gobj->p_mat = p_mat;
    _Atomic(uint64_t) *p_refcount =  get_atomic_p_flags(p_gobj);
    atomic_init(p_refcount,
         FLAG_G | FLAG_SHORT | FLAG_REDUCED | FLAG_STABLE);
    p_gobj->len_g = p_gobj->len_g_reduced = 0;
    p_gobj->sub_op = p_gobj->substatus = 0;
    set_int_g_neutral(p_gobj);
    return p_gobj;
}




/**
   @brief Delete an object of type ``mm_fast_g_type``

   The function deletes an object of type ``mmv_fast_matrix_type``.
   It deletes the object itself and the vector of
   type ``mmv_fast_matrix_type`` associated with that object.
   
   No other thread may use this object when calling this function.
*/
// %%EXPORT p
void fast_g_obj_delete(mm_fast_g_type *p_gobj)
{
    if (p_gobj == NULL) return;
    get_write_access(p_gobj, (uint64_t)(-1LL));
    // quick and dirty destruction, using interals of mmv_fast_matrix_type
    mm_op_fast_dealloc(p_gobj->p_mat);
}





/**********************************************************************
* Freeze an object of type ``mm_fast_g_type``
**********************************************************************/


/**
   @brief Freeze an object of type ``mm_fast_g_type``

   After freezing an object, it may no longer be modified. However,
   additional attributes of that object may be computed on demand in
   a thread-save manner after freezing. The object is not thread safe
   before freezing it.
*/
// %%EXPORT p
void fast_g_obj_freeze(mm_fast_g_type *p_gobj)
{
    if (p_gobj == NULL) return;
    uint64_t flags = get_write_access(p_gobj, FLAG_FROZEN);
    release_write_access(p_gobj, flags, flags | FLAG_FROZEN);
}


/**********************************************************************
* Compute more attributes of an object of type ``mm_fast_g_type``
**********************************************************************/

/// @cond DO_NOT_DOCUMENT


/**
   @brief Add sparse matrix of vectors to object of type ``mm_fast_g_type``

   The function adds a sparse matrix to an element of the Monster
   of type ``mm_fast_g_type``. It is assumed that the object has
   flags ``flags``, as obtained by function ``get_write_access``.
   The function returns the updated flags without changing the flags
   of the object.
*/
static int64_t compute_mat(mm_fast_g_type *p_gobj, int64_t flags)
{
    uint32_t g_len = 0, *pg;
    int64_t status = -1;
    if (flags & FLAG_MAT) return flags;
    if (flags & FLAG_REDUCED) {
         pg = p_gobj->g_reduced;
         g_len = p_gobj->len_g_reduced;
    } else if (flags & FLAG_G) {
         pg = p_gobj->g;
         g_len = p_gobj->len_g;
    } else return set_error(p_gobj, 1002, status); 
    mm_axis3_fast_mode1_set_vstd(p_gobj->p_mat, 1);
    status = mm_op_fast_word(p_gobj->p_mat, pg, g_len, 1);
    if (status < 0) return set_error(p_gobj, 1003, status); 
    return flags | FLAG_MAT;
}


/**
   @brief Add the reduced word to object of type ``mm_fast_g_type``

   The function adds the reduced word to an element of the Monster
   of type ``mm_fast_g_type``. It is assumed that the object has
   flags ``flags``, as obtained by function ``get_write_access``.
   The function returns the updated flags without changing the flags
   of the object.
*/
static int64_t compute_reduced_subgroup(mm_fast_g_type *p_gobj, int64_t flags)
{
    if (flags & ~FLAG_G) return flags;
    if (flags & FLAG_REDUCED) return flags;
    int32_t res = fast_g_obj_subgroup_mul_e(p_gobj->g, p_gobj->len_g, 1,
                    NULL, 0, 0, p_gobj->g_reduced, p_gobj->int_g);
    if (res < 0) return flags;
    p_gobj->len_g_reduced = res;
    return flags | (FLAG_REDUCED | FLAG_SHORT | FLAG_G);    
}



/**
   @brief Add the reduced word to object of type ``mm_fast_g_type``

   The function adds the reduced word to an element of the Monster
   of type ``mm_fast_g_type``, and also the compress integer
   representation. It is assumed that the object has
   flags ``flags``, as obtained by function ``get_write_access``.
   The function returns the updated flags without changing the flags
   of the object.
*/
static int64_t compute_reduced(mm_fast_g_type *p_gobj, int64_t flags)
{
    int32_t len;
    if (flags & FLAG_REDUCED) return flags;
    if ((flags & FLAG_MAT) == 0) return set_error(p_gobj, 2001, -1);
    len = mm_axis3_fast_reduce_v_g(p_gobj->p_mat, p_gobj->g_reduced,
        MM_FAST_MAXLEN_G_RED, p_gobj->int_g, 0x1f); 
    if (len < 0 || len > MM_FAST_MAXLEN_G_RED)
        return set_error(p_gobj, 2002, len | (uint64_t)(-0x80000000LL));
    p_gobj->len_g = 0;
    p_gobj->len_g_reduced = len;
    return flags | (FLAG_REDUCED | FLAG_SHORT | FLAG_G);
}







/**
   @brief Augment attributes of an object of type ``mm_fast_g_type``

   Depending on the ``requested`` flags, the function computes the
   attributes of the object ``p_gbj`` of type ``mm_fast_g_type``.
   This computation is thread safe if the object is frozen.
*/
static inline
int64_t augment(mm_fast_g_type *p_gobj, uint64_t requested)
{
    requested &= DATA_FLAGS;
    uint64_t flags = get_write_access(p_gobj, requested);
    uint64_t new_flags = flags;
    if ((flags & requested) == requested) {
        if ((flags & FLAG_STABLE) == 0) // we are pedantic here
            return release_write_access(p_gobj, flags, flags);
        return flags;
    }
    if ((flags | requested) & FLAG_ERROR) {
        new_flags = set_error(p_gobj, 5001, -1);
        return  release_write_access(p_gobj, flags, new_flags);
    }

    if (requested & ~flags & FLAG_G) requested |= FLAG_REDUCED;
    if (requested & ~flags & FLAG_SHORT) {
        if ((flags & FLAG_G) == 0 || (p_gobj->len_g > MM_FAST_MAXLEN_G_RED))
            requested |= FLAG_REDUCED;
        else new_flags |= FLAG_SHORT;
    }
    if (requested & ~flags & FLAG_REDUCED) {
        new_flags = compute_reduced_subgroup(p_gobj, new_flags);
        if (requested & ~new_flags & FLAG_REDUCED) requested |= FLAG_MAT;
    }
    if (requested & ~new_flags & FLAG_MAT)
        new_flags = compute_mat(p_gobj, new_flags);
    if (new_flags & FLAG_ERROR)
        return  release_write_access(p_gobj, flags, new_flags);
    if (requested & ~new_flags & FLAG_REDUCED)
        new_flags = compute_reduced(p_gobj, new_flags);
    if (new_flags & FLAG_ERROR)
        return  release_write_access(p_gobj, flags, new_flags);
    // if (new_flags & FLAG_ERROR)
    //     return  release_write_access(p_gobj, flags, new_flags);
    return  release_write_access(p_gobj, flags, new_flags);
}



/// @endcond


/**
   @brief Augment attributes of an object of type ``mm_fast_g_type``

   Depending on the ``requested`` flags, the function computes the
   attributes of the object ``p_gbj`` of type ``mm_fast_g_type``.
   This computation is thread safe if the object is frozen.
   The function returns the flags of the augmented object.
   Flags set in argument ``kill`` are cleared before augmenting.
   This function is for debugging.
*/
// %%EXPORT p
int64_t fast_g_obj_augment(mm_fast_g_type *p_gobj, uint64_t requested, uint64_t kill)
{
    if (p_gobj == NULL) return FLAG_ERROR | FLAG_FROZEN;
    if (kill) {
        uint64_t flags = get_write_access(p_gobj, 0);
        release_write_access(p_gobj, flags, flags & ~(kill & 0xff));
    }
    return  augment(p_gobj, requested);
}




/**********************************************************************
* Obtain data of an object of type ``mm_fast_g_type``
**********************************************************************/

/// @cond DO_NOT_DOCUMENT

/**
   @brief Obtain word of generators of object of type ``mm_fast_g_type``

   The function computes a word of generators for an element ``*p_gobj``
   of the Monster type ``mm_fast_g_type``. It returns a pointer to that
   word, or NULL in case of failure. It stores the length of that word
   in ``*p_len``. If ``reduced`` is nonzero, the computed word is reduced.
   Otherwise we just assert that the length of the word does not
   exceed a certain value.
*/
static inline 
uint32_t *fast_g_obj_get_g(mm_fast_g_type *p_gobj, uint32_t reduced, uint32_t* p_len)
{
    int32_t op = 4001;
    if (p_gobj == NULL) return NULL;
    uint64_t requested = reduced  ? FLAG_REDUCED : FLAG_SHORT; 
    uint64_t flags = augment(p_gobj, requested);
    if (flags & FLAG_ERROR) goto failure;
    if (flags & FLAG_REDUCED) {
        if (p_len) *p_len = p_gobj->len_g_reduced; 
        return p_gobj->g_reduced;
    } else if (flags & FLAG_SHORT) {
        op = 4002;
        if (reduced) goto failure;
        if (p_len) *p_len = p_gobj->len_g; 
        return p_gobj->g;
    } else {
        op = 4003;
    }
failure:
    set_error(p_gobj, op, -1);
    return NULL;
}

/// @endcond


/**
   @brief Store word of generators of object of type ``mm_fast_g_type``

   The function stores a word of generators for an element ``*p_gobj``
   of the Monster type ``mm_fast_g_type`` in the buffer ``pg`` of
   size ``lg``. It returns the actual length of that word or a
   negative value in case of an error. If ``reduced`` is nonzero,
   the stored word is reduced. Otherwise we just assert that the
   length of the word does not exceed a certain value.
*/
// %%EXPORT p
int32_t fast_g_obj_store_g(mm_fast_g_type *p_gobj, uint32_t reduced, uint32_t* pg, uint32_t lg)
{
    uint32_t len, i;
    uint32_t *pg0 = fast_g_obj_get_g(p_gobj, reduced, &len);
    if (pg0 == NULL) return -1;
    if (len > lg && reduced == 0) {
        pg0 = fast_g_obj_get_g(p_gobj, 1, &len);
        if (pg0 == NULL) return -1;
        if (len > lg) return -2;
    }
    for (i = 0; i < len; ++i) pg[i] = pg0[i];
    return len;
}




/**
   @brief Check if object of type ``mm_fast_g_type`` is the neutral element

   The function checks if the object ``*p_gobj`` of the Monster of
   type ``mm_fast_g_type`` is the neutral element. It returns 0 if this is
   the case, 1 if not, -1 if this is not known, and -2 in case of an error.
   If ``reduced`` is nonzero, the computed word is reduced before checking.
*/
// %%EXPORT p
int32_t fast_g_obj_nonneutral(mm_fast_g_type *p_gobj, uint32_t reduced)
{
    uint32_t flags = get_flags(p_gobj);
    if (flags & FLAG_ERROR) return -2;
    if (reduced) flags = augment(p_gobj, FLAG_REDUCED); 
    if (flags & FLAG_ERROR) return -2;
    if (flags & FLAG_REDUCED) return p_gobj->len_g_reduced != 0; 
    else if (flags & FLAG_G) return p_gobj->len_g ? -1 : 0; 
    else return -1;
}





/**
   @brief sparse matrix of object of type ``mm_fast_g_type``

   The function computes the sparse matrix of vectors of an 
   element ``*p_gobj`` of the Monster, which is of 
   type ``mm_fast_matrix_type``. It returns a pointer to that vector
   of, or NULL in case of failure. 
*/
// %%EXPORT p
mmv_fast_matrix_type *fast_g_obj_get_mat(mm_fast_g_type *p_gobj)
{
    if (p_gobj == NULL) return NULL;
    uint64_t flags = augment(p_gobj, FLAG_MAT);
    if (flags & FLAG_ERROR || (flags & FLAG_MAT) == 0) {
        set_error(p_gobj, 7001, -1);
        return NULL;
    }
    return  p_gobj->p_mat;
}



/**
   @brief Compress object of type ``mm_fast_g_type``

   The function computes a integer of at most 231 bit length that
   represents the element ``**p_gobj``  of the Monster in a compressed
   form. It  stores this number in an array ``a`` of 4 entries of
   type ``uint64_t``.  Then the computed integer value is the sum

   sum     2 ** (64 * i) * a[i] ,

   where i runs from 0 to 3. The function returns 0 in case of
   success and a negatve value failure.

   Caution:
   The integer value computed by this function differs from the 
   value computed by function ``gt_word_compress`` in
   file ``mm_shorten.c``.

   Both types of compressed integer values can be decompressed with
   function ``mm_compress_pc_expand_int`` in file ``MM_compress.c``. 
*/
// %%EXPORT p
int32_t fast_g_obj_store_int_fast(mm_fast_g_type *p_gobj, uint64_t *a)
{
    if (p_gobj == NULL) return -1;
    uint64_t flags = augment(p_gobj, FLAG_REDUCED);
    if (flags & FLAG_ERROR || (flags & FLAG_REDUCED) == 0) return -2;
    uint32_t i;
    for (i = 0; i < 4; ++i) a[i] = p_gobj->int_g[i];
    return 0;
}



/**********************************************************************
* Set object of type ``mm_fast_g_type`` to the neutral element
**********************************************************************/

/**
   @brief Set object of type ``mm_fast_g_type`` to the neutral element

   The function return 0 in case of success and a negative value in
   case of error;.
*/
// %%EXPORT p
int32_t fast_g_obj_setneutral(mm_fast_g_type *p_gobj)
{
    uint32_t flags = get_flags(p_gobj);
    if (is_mutable(flags) == 0) return ERROR_MUTABLE;
    _Atomic(uint64_t) *p_flags = get_atomic_p_flags(p_gobj);
    atomic_store(p_flags, 0);  // paranoia
    p_gobj->len_g = p_gobj->len_g_reduced = 0;
    set_int_g_neutral(p_gobj);
    atomic_store(p_flags,
         FLAG_G | FLAG_SHORT | FLAG_REDUCED | FLAG_STABLE);
    return 0;
}


/**********************************************************************
* Copy data of object of type ``mm_fast_g_type``
**********************************************************************/


/**
   @brief Copy data of object of type ``mm_fast_g_type``

   Here the object of type ``mm_fast_g_type`` referred by ``p_gobj``
   must be mutable. The function copies the object referred by ``p_src``
   to the object  referred by ``p_gobj``. If ``g_only`` is nonzero
   then only a (short, not necessarily reduced) word ``g`` is copied,
   and the word ``g`` in the copy ``*p_gobj`` is declared non-reduced.
 
   The function return 0 in case of success and a negative value in
   case of error.
*/
// %%EXPORT p
int32_t fast_g_obj_copy(mm_fast_g_type *p_gobj, mm_fast_g_type *p_src, uint32_t g_only)
{
    uint32_t flags = get_flags(p_gobj);
    if (is_mutable(flags) == 0) return ERROR_MUTABLE;
    int32_t status = -1;
    if (p_src == NULL) set_error_ret(p_gobj, 21001, -1);
    _Atomic(uint64_t) *p_flags = get_atomic_p_flags(p_gobj);
    uint32_t new_flags = 0;
    uint32_t src_flags = get_flags(p_src);
    if (g_only) {
        atomic_store(p_flags, 0);  // paranoia
        status = fast_g_obj_store_g(p_src, 0, p_gobj->g, MM_FAST_MAXLEN_G_RED);
        if (status < 0) return set_error_ret(p_gobj, 21002, -1);
        p_gobj->len_g = (uint32_t)status;
        p_gobj->len_g_reduced = 0;
        new_flags = FLAG_G | FLAG_SHORT;
        atomic_store(p_flags, new_flags);
        return 0;
    }
    if (p_gobj == p_src) return 0;
    atomic_store(p_flags, 0);  // paranoia
    if (src_flags & FLAG_MAT) {
        status = mm_op_fast_copy_data(p_src->p_mat, p_gobj->p_mat);
        if (status < 0) return set_error_ret(p_gobj, 21003, status);
        new_flags |= FLAG_MAT;
    } 
    uint32_t reduced = (src_flags & FLAG_REDUCED) != 0;
    p_gobj->len_g_reduced = p_gobj->len_g = 0;
    status = fast_g_obj_store_g(p_src, reduced, 
          reduced ? p_gobj->g_reduced : p_gobj->g, MM_FAST_MAXLEN_G_RED);
    if (status < 0) return set_error_ret(p_gobj, 21008, -1);
    if (reduced) {
        for (uint32_t i = 0; i < 4; ++i) p_gobj->int_g[i] = p_src->int_g[i];
        p_gobj->len_g_reduced = status;
        new_flags |= FLAG_REDUCED | FLAG_SHORT | FLAG_G;
    } else if (src_flags & FLAG_G)  {
        p_gobj->len_g = status;
        new_flags |= FLAG_G | FLAG_SHORT;
    } 
    if ((flags & (FLAG_G | FLAG_MAT)) == 0) 
        return set_error_ret(p_gobj, 21009, -1);
    atomic_store(p_flags, new_flags);
    return 0; 
}






/**********************************************************************
* Low-level Multiplication for object of type ``mm_fast_g_type``
**********************************************************************/


/**
   @brief Low level function for function ``fast_g_obj_mulexp``

   Here the object of type ``mm_fast_g_type`` referred by ``p_gobj``
   must be mutable. It is multiplied by the element g**e, where g
   is stored as a word of length ``len_g`` in the buffer ``g``.
   This costs up to len_g * abs(e) vector operations.
 
   The function return 0 in case of success and a negative value in
   case of error
*/
int32_t mulexp(mm_fast_g_type *p_gobj, uint32_t *g, uint32_t len_g, int32_t e)
{
    uint32_t flags = get_flags(p_gobj);
    if (is_mutable(flags) == 0) return ERROR_MUTABLE;
    _Atomic(uint64_t) *p_flags = get_atomic_p_flags(p_gobj);
    if (e == 0 || len_g == 0) return 0;  

    // Compute No of words of of *p_gobj in lg, and |e| * len(g) in llen_g, 
    // abort if |e| * len(g) to be multiplied is too large
    int64_t llen_g = e;
    llen_g = (int64_t)len_g * (llen_g > 0 ? llen_g : -llen_g);
    if ((uint64_t)(abs(llen_g)) > 0x10000LL) 
        return set_error_ret(p_gobj, 31002, -1);
    uint32_t lg = (flags & FLAG_REDUCED)
                ? p_gobj->len_g_reduced : p_gobj->len_g;

    // try to work in a subgroup
    if (flags & FLAG_G) {
        uint32_t *pg = (flags & FLAG_REDUCED)
                ? p_gobj->g_reduced : p_gobj->g;
        int32_t status = fast_g_obj_subgroup_mul_e(pg, lg, 1,
            g, len_g, e, p_gobj->g_reduced, p_gobj->int_g);
        if (status >= 0) {
            p_gobj->len_g_reduced = status;
            atomic_store(p_flags, flags | FLAG_REDUCED | FLAG_SHORT);
            return 0;
        }
    }

    // Compute component p_gobj->mat  if needed
    if ((flags & FLAG_G) == 0 || (llen_g + lg) > MM_FAST_MAXLEN_G 
       || abs(e) > 4 ) {
        flags = augment(p_gobj, FLAG_MAT);
        if ((flags  & FLAG_MAT) == 0 || (flags & FLAG_ERROR))
            return set_error_ret(p_gobj, 31003, -1);
    }

    atomic_store(p_flags, 0);  // paranoia
    // Multiply component p_gobj->mat by g**e if present
    if (flags  & FLAG_MAT) {
        uint32_t status = mm_op_fast_word(p_gobj->p_mat, g, len_g, e);
        if (status < 0) return set_error_ret(p_gobj, 31004, status);
    } 

    uint64_t maxlen = (flags & FLAG_MAT) ? MM_FAST_MAXLEN_G_RED
                                          : MM_FAST_MAXLEN_G;
    if ((flags & FLAG_G) && (llen_g + lg) <= maxlen) {
        // Then store result also as word of generators 
        if (flags & FLAG_REDUCED) {
            // Mark object es unreduced
            for (uint32_t i = 0; i < lg; ++i) {
                p_gobj->g[i] = p_gobj->g_reduced[i];
            }
            p_gobj->len_g = lg;
            p_gobj->len_g_reduced = 0;
        }
        flags &= ~FLAG_REDUCED;
        // Append g**e to object
        uint32_t *p_start = p_gobj->g + lg;
        for (uint32_t i = 0; i < len_g; ++i) p_start[i] = g[i];
        if (e < 0) {
            mm_group_invert_word(p_start, len_g);
            e = -e;
        }
        for (uint32_t j = 0; j < e - 1; ++j) {
            for (uint32_t i = 0; i < len_g; ++i) 
                p_start[i+len_g] = p_start[i];
            p_start += len_g;
        }
        // adjust length of g and flags
        p_gobj->len_g += e * len_g;
        if (p_gobj->len_g <= MM_FAST_MAXLEN_G_RED) {
            flags |= FLAG_SHORT;
        } else {
            flags &= ~FLAG_SHORT;
        }
    } else {
        p_gobj->len_g = p_gobj->len_g_reduced = 0;
        flags &= ~(FLAG_REDUCED | FLAG_SHORT | FLAG_G);
    }
    if ((flags & (FLAG_G | FLAG_MAT)) == 0) 
        return set_error_ret(p_gobj, 31009, -1);
    atomic_store(p_flags, flags);
    return 0;
}



/**
   @brief Low level function for function ``fast_g_obj_mulexp_obj``

   Here the object of type ``mm_fast_g_type`` referred by ``p_gobj``
   must be mutable. It is multiplied by the element g**e, where g
   is stored in the object referred by ``p_src``.
   This costs up to len_g * abs(e) vector operations.
 
   The function return 0 in case of success and a negative value in
   case of error
*/
static inline int32_t 
mulexp_obj(mm_fast_g_type *p_gobj, mm_fast_g_type *p_src, int32_t e)
{
    if (e == 0) return 0;
    uint32_t g_buf[MM_FAST_MAXLEN_G_RED];
    int32_t status = fast_g_obj_store_g(p_src, 0, g_buf, MM_FAST_MAXLEN_G_RED);
    if (status < 0) return set_error_ret(p_gobj, 31022, status);
    return mulexp(p_gobj, g_buf, status, e);
}




/**********************************************************************
* Exponentiation of an object of type ``mm_fast_g_type``
**********************************************************************/

/**
   @brief Set object of type ``mm_fast_g_type`` to the ``e``-th power

   Here the object of type ``mm_fast_g_type`` referred by ``p_gobj``
   must be mutable. It is set to the element g**e, where g
   is stored in the object referred by ``p_src``.
   This costs up to len_g * abs(e) vector operations.
 
   The function return 0 in case of success and a negative value in
   case of error
*/
// %%EXPORT p
int32_t fast_g_obj_setpower(mm_fast_g_type *p_gobj, mm_fast_g_type *p_src, int64_t e)
{
    uint32_t flags = get_flags(p_gobj);
    if (is_mutable(flags) == 0) return ERROR_MUTABLE;
    int64_t op = 32001, status = -1;
    mm_fast_g_type *f1 = NULL, *f3 = NULL, *f;
    if (e == 0) return fast_g_obj_setneutral(p_gobj);
    if (e > 1) {
         if (augment(p_gobj, FLAG_SHORT | FLAG_MAT) & FLAG_ERROR)
             goto failure;
    }
    if (fast_g_obj_copy(p_gobj, p_src, e < 0) < 0) goto failure;
    if (e == 1) return 0;
    uint64_t ue = e;
    if (e < 0) {
        uint32_t g_len = 0;
        uint32_t *p_g = fast_g_obj_get_g(p_gobj, 0, &g_len);
        if (p_g == NULL) goto failure;
        mm_group_invert_word(p_g, g_len);
        ue = -ue;
    }
    if (ue < 6) return mulexp_obj(p_gobj, p_gobj, ue - 1);
    while ((ue & 3) == 0) {
        status = mulexp_obj(p_gobj, p_gobj, 3);
        if (status < 0) goto failure;
        ue >>= 2;
    }
    status = -1;
    while ((ue % 3) == 0) {
        status = mulexp_obj(p_gobj, p_gobj, 2);
        if (status < 0) goto failure;
        ue = ue / 3;
    }
    status = -1;
    if (ue < 6) return mulexp_obj(p_gobj, p_gobj, ue - 1);

    // Now ue >= 6. Process the first two bits after the leading bit
    // of ue and store 1st and 3rd power of basis in f1 and f3.

    int32_t bpos = uint64_bit_len(ue) - 1; // pos. of leading bit
    uint32_t d = (ue >> (bpos - 2)) & 3;    // next two bits to be done
    f1 = fast_g_obj_new();
    f3 = fast_g_obj_new();
    op = 32003;
    if (f1 == NULL || f3 == NULL) goto failure;
    status = fast_g_obj_copy(f1, p_gobj, 0);
    if (status < 0) goto failure;
    status = mulexp_obj(p_gobj, p_gobj, 2);
    if (status < 0) goto failure;
    status = fast_g_obj_copy(f3, p_gobj, 0);
    if (status < 0) goto failure;
    if (d >= 2) {
        status = mulexp_obj(p_gobj, f3, 1);
        if (status < 0) goto failure;
        if (d == 3) {
            status = mulexp_obj(p_gobj, f1, 1);
            if (status < 0) goto failure;
        }
    } else {
        status = mulexp_obj(p_gobj, f1, d + 1);
        if (status < 0) goto failure;
    }
    bpos -= 2;

    while (bpos > 0) {
        // let k be the number of bits to be processed, which is 1 or 2
        // let d be the value of this bit field, which is 0, 1, or 3
        uint32_t k = bpos < 2 ? 1 : 2;
        if (k == 2) {
            d =  (ue >> (bpos - 2)) & 3;
            if (d == 2) k = d = 1;
        } else d =  (ue >> (bpos - 1)) & 1;
        status = mulexp_obj(p_gobj, p_gobj, (1 << k) - 1);
        if (status < 0) goto failure;
        if (d) {
             f = (d == 3) ?  f3 : f1;
             status = mulexp_obj(p_gobj, f, 1);
             if (status < 0) goto failure;
        }
        bpos -= k;
    }
    fast_g_obj_delete(f1);
    fast_g_obj_delete(f3);
    return 0;

failure:
    if (f1) fast_g_obj_delete(f1);
    if (f3) fast_g_obj_delete(f3);
    return set_error_ret(p_gobj, op, status);
}









/**********************************************************************
* Multiply object of type ``mm_fast_g_type`` with word of generators
**********************************************************************/



// N_OP[i] = approximate No of operations for rising to i-th power
static uint8_t N_OP[17] =  {0,0,2,3, 4,5,5,6, 6,6,7,8, 7,8,7,8, 8};
// N_RED_LEN = average length of reduced word
#define  N_RED_LEN 41.0

static int32_t use_exp(uint32_t len_g, int64_t e)
{
     float n_op, w;
     uint64_t ue = abs(e);
     if (ue <= 1 || len_g == 0) return 0;
     if (ue <= 16) {
         n_op =  N_OP[ue];
     } else if (ue <= 256) {
         n_op = uint64_bit_len(ue-1) * 2.5 - 2;
     } else return 1;
     w = N_RED_LEN * (n_op + 1) + len_g - len_g * ue;
     return (int32_t)(w < 0);
}


/**
   @brief Multiply object of type ``mm_fast_g_type`` with word of generators

   Here the object of type ``mm_fast_g_type`` referred by ``p_gobj``
   must be mutable. It is multiplied by the element g**e, where g
   is stored as a word of length ``len_g`` in the buffer ``g``.

   The function returns 0 in case of success and a negative value in
   case of error
*/
// %%EXPORT p
int32_t fast_g_obj_mulexp(mm_fast_g_type *p_gobj, uint32_t *g, uint32_t len_g, int64_t e)
{
     if (use_exp(len_g, e) == 0) return mulexp(p_gobj, g, len_g, e);
     uint64_t abs_e = abs((int64_t)e);
     mm_fast_g_type *exp = fast_g_obj_new();
     if (exp == NULL) goto failure;
     if (mulexp(exp, g, len_g, 1) < 0) goto failure;
     if (abs_e >= 6) {
         if (fast_g_obj_setpower(exp, exp, e) < 0) goto failure;
         e = 1;
     }
     if (mulexp_obj(p_gobj, exp, e) < 0) goto failure;
     fast_g_obj_delete(exp);
     return 0;
 
failure:
    if (exp) fast_g_obj_delete(exp);
    return set_error_ret(p_gobj, 33001, -1);
}






/**
   @brief Multiply object of type ``mm_fast_g_type`` with  another object

   Here the object of type ``mm_fast_g_type`` referred by ``p_gobj``
   must be mutable. It is multiplied by the element g**e, where g
   is the  object of type ``mm_fast_g_type`` referred by ``p_src``.

   The function return 0 in case of success and a negative value in
   case of error.
*/
// %%EXPORT p
int32_t fast_g_obj_mulexp_obj(mm_fast_g_type *p_gobj, mm_fast_g_type *p_src, int32_t e)
{
    if (e == 0) return 0;
    uint32_t g_buf[MM_FAST_MAXLEN_G_RED];
    int32_t status = fast_g_obj_store_g(p_src, 0, g_buf, MM_FAST_MAXLEN_G_RED);
    if (status < 0) return set_error_ret(p_gobj, 34002, status);
    return fast_g_obj_mulexp(p_gobj, g_buf, status, e);
}




