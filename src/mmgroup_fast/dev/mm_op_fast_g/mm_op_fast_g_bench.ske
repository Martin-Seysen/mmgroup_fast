/** @file mm_op_fast_g_bench.c

 File ``mm_op_fast_g_bench.c`` provides the basic functions for
 estimating run times of functions operating on  structures of
 type ``mmv_fast_g_type``

 This is not yet functional!
*/


#include <stdint.h>
#include <stdatomic.h>
#include <stddef.h>
#include <stdlib.h>


/// @cond DO_NOT_DOCUMENT 
#define MM_OP_FAST_ALLOC
/// @endcond 

#include "mm_reduce.h"
#include "mm_op_fast.h"
#include "mm_op_sub.h"   


//  %%GEN h
/// @cond DO_NOT_DOCUMENT

//  %%GEN c



/// @cond DO_NOT_DOCUMENT



static inline void add_count(uint32_t *n_op, uint32_t n0[5])
{
    if (n0[0] == 0 && n0[1] == 0) n0[1] = n0[4];
    n_op[0] += n0[0]; n_op[1] += n0[1]; n_op[2] += n0[2];
    n0[0] = n0[1] = n0[2] = n0[4] = 0;
}


/// @endcond



/**
   @brief Count operations in word of generators of the Monster

   Let ``g`` be a word of generators of the Monster of length ``len``
   referred by ``pg``. The function counts the number of operations
   required to multiply a vector with ``g``, and stores the result in
   the output array ``n_op`` of length 4. Entries of ``n_op``
   correspond to the tags of the generators of the Monster as follows:

   0: 'p';  1: 'x', 'y', 'd';  2: 't';  3: 'l' .

   Note there is a vector operation dealing with a product of
   tags 'x', 'y', and 'd'.

   The function sets bit 0 and 1 of the return value if a nontrivial
   entry with tag 't' and 'l', respectively, occurs. It returns a
   negative value if the word contains any illegal tag.

   If parameter ``add`` is nonzero then the computed values are not  
   stored in, but added to entries of ``n_op``.
*/
// %%EXPORT px
int32_t mm_op_fast_count_g(uint32_t *pg, uint32_t len, uint32_t *n_op, uint32_t add)
{
    uint32_t n0[5], res = 0, i, j;
    if (add == 0) for (i = 0; i < 4; ++i) n_op[i] = 0;
    for (i = 0; i < 5; ++i) n0[i] = 0;
    for (i = 0; i < len; ++i) {
        uint32_t h = pg[i];
        uint32_t tag = (h >> 28) & 7;
        switch(tag) {
            case 1: // tag d
                if (h & 0xfffUL) n0[4] = 1;
                break;
            case 2: // tag p
                if (h & 0xfffffffUL) n0[0] = 1;
                break;
            case 3: // tag x
            case 4: // tag y
                if (h & 0x1fffUL) n0[1] = 1;
                break;
            case 5: // tag t
                if ((h ^ (h >> 1)) & 1) {
                    n0[2] = 1;
                    res |= 1;
                }
                break;
            case 6: // tag y
                if ((h ^ (h >> 1)) & 1) {
                    add_count(n_op, n0);
                    n_op[3] += 1;
                    res |= 2;
                }
                break;
            case 7: // 'undefined' tag
                if (h & 0xfffffffUL) {
                    for (j = 0; j < 4; ++j) n_op[j] = 0xffffffffUL;
                    return -1;
                }
                break;
            default:
                break;
        }
    }
    add_count(n_op, n0);
    return res; 
}





